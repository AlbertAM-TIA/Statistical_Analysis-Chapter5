##Post HOC Tukey’s test to show the differences between all paired level combinations for initial SOC, Soil type and Adaptation.

summary(glht(fit_with_interaction, linfct = mcp(Adaptation = "Tukey"))) # perform Tukey's test

summary(glht(fit_with_interaction, linfct = mcp(Soil_type = "Tukey"))) # perform Tukey's test

summary(glht(fit_with_interaction, linfct = mcp(Initial_SOC = "Tukey"))) # perform Tukey's test


## Generate LM Model report
report::report(fit_with_interaction)
